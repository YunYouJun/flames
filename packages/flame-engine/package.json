{
  "name": "@yunyoujun/flame-engine",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic Three.js runtime for procedural flame experiences.",
  "author": "YunYouJun",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "nr build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "catalog:"
  },
  "devDependencies": {
    "@types/three": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

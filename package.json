{
  "name": "flames",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nr -r build",
    "budget:web": "node scripts/check-web-budgets.mjs",
    "dev": "pnpm --filter @yunyoujun/flames-web dev",
    "dev:all": "nr -r dev",
    "generate": "pnpm --filter @yunyoujun/flame-engine build && pnpm --filter @yunyoujun/flames-web generate",
    "lint": "eslint --cache .",
    "prepublishOnly": "nr build",
    "predocs": "typedoc",
    "docs:dev": "pnpm -C docs run docs:dev",
    "docs:build": "pnpm build && pnpm predocs && pnpm -C docs run docs:build",
    "docs:preview": "pnpm -C docs run docs:preview",
    "e2e": "playwright test",
    "release": "bumpp -r && pnpm -r publish",
    "test": "vitest run",
    "typecheck": "nr -r typecheck",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@antfu/ni": "catalog:",
    "@antfu/utils": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "lint-staged": "catalog:",
    "publint": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
